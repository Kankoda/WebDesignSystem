<article class="wrapper wide slide-in">
  <h2>Text</h2>
  <p>Paragraphs have a light weight and support <a href="#text">links</a>, <b>bold</b> and <i>italic</i> text.</p>
  <div>
    <h1 class="glass">Heading 1</h1>
    <h2>Heading 2</h2>
    <h3>Heading 3</h3>
    <h4>Heading 4</h4>
  </div>

  <h3>Glass Colors</h3>
  <div>
    {% assign colors = "blue,green,yellow,orange,red,purple" | split: "," %}
    {% for color in colors %}
    <h2 class="glass {{ color }}">{{ color | capitalize }}</h2>
    {% endfor %}
  </div>
</article>
